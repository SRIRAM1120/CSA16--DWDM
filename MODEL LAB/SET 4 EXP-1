
# Given dataset
data <- c(2,3,3,4,4,4,6,6,6,6,7,7,
          8,9,9,10,10,10,11,11,12,12,12,12,
          13,14,14,15,15,15,16,16,17,18,18,18,
          18,19,20,20,20,21,22,22,23,24,25,25)

# Equal frequency partitioning
bins <- split(data, rep(1:4, each=12))

print("Equal Frequency Bins")
print(bins)

# Smoothing using bin means
bin_means <- sapply(bins, mean)
print("Bin Means")
print(bin_means)

smooth_mean <- lapply(bins, function(x) {
  rep(round(mean(x), 2), length(x))
})
print("Smoothing by Bin Means")
print(smooth_mean)

# Smoothing using bin boundaries
smooth_boundary <- lapply(bins, function(x) {
  low <- min(x)
  high <- max(x)
  sapply(x, function(v) {
    if(abs(v-low) <= abs(v-high)) low else high
  })
})

print("Smoothing by Bin Boundaries")
print(smooth_boundary)

# Histogram
barplot(rep(12,4),
        names.arg=paste("Bin",1:4),
        main="Equal Frequency Histogram",
        xlab="Bins",
        ylab="Frequency",
        col="skyblue")
